# -----------------------------------------------------------------------------
# The Champions Club - Environment Variables Template
# -----------------------------------------------------------------------------
# Copy this file to .env.local and populate the values for local development.
# NEVER commit .env.local or any file containing real secret keys to source control!

# Public Supabase Configuration (Exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Server-Only Supabase Configuration (NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLUB_NAME="The Champions Club"

# -----------------------------------------------------------------------------
# Rate Limiting Configuration (Configurable Thresholds)
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true

# 1. Strictest: Authentication Routes (login, signup, password reset)
RATE_LIMIT_AUTH_IP_MAX=5
RATE_LIMIT_AUTH_IP_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_ACCOUNT_MAX=5
RATE_LIMIT_AUTH_ACCOUNT_WINDOW_SECONDS=300
RATE_LIMIT_AUTH_BACKOFF_BASE_SECONDS=2
RATE_LIMIT_AUTH_BACKOFF_FACTOR=2.0
RATE_LIMIT_AUTH_BACKOFF_MAX_SECONDS=900
RATE_LIMIT_AUTH_BACKOFF_COOLDOWN_SECONDS=600

# 2. Moderate: Public Endpoints (landing pages, trial forms, public catalog)
RATE_LIMIT_PUBLIC_IP_MAX=60
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=60

# 3. Loosest: Authenticated Actions (dashboard, court bookings, bar orders, staff operations)
RATE_LIMIT_AUTHED_USER_MAX=300
RATE_LIMIT_AUTHED_WINDOW_SECONDS=60

