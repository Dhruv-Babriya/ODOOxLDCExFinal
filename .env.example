# -----------------------------------------------------------------------------
# The Champions Club - Environment Variables Template
# -----------------------------------------------------------------------------
# Copy this file to .env.local and populate the values for local development.
# NEVER commit .env.local or any file containing real secret keys to source control!

# Public Supabase Configuration (Exposed to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Server-Only Supabase Configuration (NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLUB_NAME="The Champions Club"
